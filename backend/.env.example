
# 通用
ENV=production
API_BASE_URL=http://127.0.0.1:8483
SCREENSHOT_BASE_URL=http://127.0.0.1:8483/static/screenshots
STATIC=/static # 外部访问路径（URL 前缀）
OUT_DIR=./static/screenshots    # 本地输出目录
IMAGE_BASE_URL=/static/screenshots  # 图片访问 URL

# 数据存储配置（相对于项目根目录，不是 backend 目录）
DATA_DIR=data                      # 数据根目录
NOTE_OUTPUT_DIR=data/notes         # 笔记存储目录
MEDIA_DIR=data/media               # 媒体文件目录（音频/视频）
CACHE_DIR=data/cache               # 临时缓存目录
EXPORT_DIR=data/exports            # 导出文件目录

# WebDAV 备份加密密钥
# 重要：请设置一个固定密钥以避免重启后无法解密密码
# 建议使用 32 字符以上的随机字符串
WEBDAV_ENCRYPTION_KEY=your-secret-key-change-this-in-production

# transcriber 相关配置
TRANSCRIBER_TYPE=fast-whisper # fast-whisper/bcut/kuaishou
WHISPER_MODEL_SIZE=base

# 缓存清理配置
CACHE_TTL_DAYS=7                    # 缓存文件过期时间（天数），默认 7 天
CACHE_CLEAN_SCHEDULE=0 3 * * *      # 缓存清理定时任务 Cron 表达式，默认每天凌晨 3 点执行