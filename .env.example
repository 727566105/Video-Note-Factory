# 通用端口配置
BACKEND_PORT=8483
BACKEND_HOST=0.0.0.0
FRONTEND_PORT=3015
APP_PORT=3015

# 前端访问后端用 (开发环境使用)
VITE_API_BASE_URL=http://127.0.0.1:8483
VITE_SCREENSHOT_BASE_URL=http://127.0.0.1:8483/static/screenshots
VITE_FRONTEND_PORT=3015

# 生产环境配置
ENV=production
STATIC=/static
OUT_DIR=./static/screenshots
IMAGE_BASE_URL=/static/screenshots

# 数据存储配置（相对于项目根目录）
DATA_DIR=data
NOTE_OUTPUT_DIR=data/notes
MEDIA_DIR=data/media
CACHE_DIR=data/cache
EXPORT_DIR=data/exports

# FFMPEG 配置
FFMPEG_BIN_PATH=

# JWT 配置（必填）
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# CORS 配置（生产环境生效，逗号分隔）
ALLOWED_ORIGINS=http://localhost:3015

# transcriber 相关配置
TRANSCRIBER_TYPE=fast-whisper
WHISPER_MODEL_SIZE=base
GROQ_TRANSCRIBER_MODEL=whisper-large-v3-turbo

# HuggingFace 镜像（国内用户推荐）
HF_ENDPOINT=https://hf-mirror.com

# WebDAV 加密密钥配置
# 重要：请设置一个固定密钥以避免重启后无法解密密码
# 建议使用 32 字符以上的随机字符串
WEBDAV_ENCRYPTION_KEY=your-secret-key-change-this-in-production

# 缓存清理配置
CACHE_TTL_DAYS=7
CACHE_CLEAN_SCHEDULE=0 3 * * *