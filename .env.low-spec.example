# 低配 NAS 服务器优化配置模板
# 适用于 CPU 性能较弱的服务器（如 J4125、N5105 等）

# ========================================
# 任务并发控制（关键优化）
# ========================================
# 串行执行，避免多任务抢占 CPU
MAX_CONCURRENT_TASKS=1

# ========================================
# 转写器优化（最耗 CPU 的环节）
# ========================================
# 使用最轻量的 whisper 模型
TRANSCRIBER_TYPE=fast-whisper
WHISPER_MODEL_SIZE=tiny

# Groq API 转写（云端算力，完全解放本地 CPU）
# 如果有 Groq API，优先使用云端转写
# TRANSCRIBER_TYPE=groq
# GROQ_TRANSCRIBER_MODEL=whisper-large-v3-turbo

# ========================================
# 视频下载优化（带宽和存储）
# ========================================
# 强制 1080p（已默认，节省存储）
# 如果不需要视频文件，可在前端选择"仅音频"

# ========================================
# 端口配置
# ========================================
BACKEND_PORT=8483
BACKEND_HOST=0.0.0.0
FRONTEND_PORT=3016
APP_PORT=3016

# ========================================
# 数据存储配置
# ========================================
DATA_DIR=data
NOTE_OUTPUT_DIR=data/notes
MEDIA_DIR=data/media
CACHE_DIR=data/cache
EXPORT_DIR=data/exports

# ========================================
# JWT 配置
# ========================================
JWT_SECRET_KEY=请设置一个随机密钥

# ========================================
# CORS 配置
# ========================================
ALLOWED_ORIGINS=http://localhost:3016

# ========================================
# 缓存清理配置
# ========================================
# 7天清理缓存，节省存储空间
CACHE_TTL_DAYS=7
CACHE_CLEAN_SCHEDULE=0 3 * * *

# ========================================
# WebDAV 加密密钥（可选）
# ========================================
WEBDAV_ENCRYPTION_KEY=